# demo (predeterminado): sin base ni credenciales. live: operación real.
APP_MODE=demo
DATABASE_URL=postgresql://tienda:REEMPLAZAR@localhost:5432/tienda
# Producción: usar una URL PostgreSQL online. Si el proveedor requiere conexión
# directa para migraciones, definir DIRECT_URL además de DATABASE_URL (pool).
# DIRECT_URL=postgresql://USUARIO:CLAVE@HOST_DIRECTO/BASE?sslmode=require
BETTER_AUTH_SECRET=GENERAR_CON_SETUP
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Solo pruebas: base separada, el script borra sus registros.
TEST_DATABASE_URL=postgresql://tienda:REEMPLAZAR@localhost:5432/tienda_test
